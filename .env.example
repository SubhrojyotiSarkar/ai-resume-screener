# =============================================================================
# AI Resume Screener: environment configuration
# Copy to `.env` and change every `change-me` value before running:
#   cp .env.example .env
# docker-compose reads this file. When you run a service outside Docker,
# it reads the same file, so the *_URL values below point at localhost.
# Avoid characters like @ : / # ? in passwords (they are embedded in URLs).
# =============================================================================

NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=screener
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=resume_screener
# Host port that Postgres is published on.
POSTGRES_PORT=5432
# Used by the server outside Docker (compose builds its own URL for the `postgres` host).
# In production, use your Neon connection string (with ?sslmode=require).
DATABASE_URL=postgresql://screener:change-me-postgres@localhost:5432/resume_screener?schema=public

# ---------- MongoDB ----------
MONGO_ROOT_USER=screener
MONGO_ROOT_PASSWORD=change-me-mongo
MONGO_PORT=27017
MONGO_DB=resume_screener
# Used by the matcher outside Docker. In production, use your Atlas M0 SRV string.
MONGO_URL=mongodb://screener:change-me-mongo@localhost:27017/?authSource=admin

# ---------- Object storage (MinIO locally, Cloudflare R2 in production) ----------
# Server-side S3 endpoint. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=http://localhost:9000
# Optional. Host used when signing download URLs for the browser. Only needed when
# the server reaches storage via an internal hostname (e.g. `minio` in Docker).
# Leave empty to reuse STORAGE_ENDPOINT (correct for R2).
STORAGE_PUBLIC_ENDPOINT=
STORAGE_BUCKET=resumes
# Locally these double as the MinIO root credentials (secret: min 8 chars).
STORAGE_ACCESS_KEY=screener-minio
STORAGE_SECRET_KEY=change-me-minio-secret
# `auto` for R2; any value (e.g. us-east-1) works for MinIO.
STORAGE_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Official minio/minio images are no longer published; this is a maintained community build.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-10-26T00-00-00Z

# ---------- Shared secret between server and matcher (X-Internal-Key header) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-internal-key-at-least-16-chars

# ---------- Server (Node/Express) ----------
SERVER_PORT=4000
# Generate a long random value (same command as above).
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Allowed CORS origin: the URL the client is served from.
CLIENT_URL=http://localhost:5173
# Where the server reaches the matcher (compose overrides this to http://matcher:8000).
MATCHER_URL=http://localhost:8000

# ---------- Demo seed (npm run db:seed) ----------
# Login for the demo recruiter created by the seed script. Change the password.
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=change-me-demo-password

# ---------- Client (React/Vite) ----------
CLIENT_PORT=5173
# Base URL of the API, baked into the client bundle at build time.
VITE_API_URL=http://localhost:4000/api
